# All variables are optional; defaults work for local development.
# Root folder for the Parquet landing zone and the DuckDB warehouse.
PAYMENTS_DATA_DIR=./data
# DuckDB file used by dbt (defaults to $PAYMENTS_DATA_DIR/warehouse/payments.duckdb).
DUCKDB_PATH=./data/warehouse/payments.duckdb
# First day of the Dagster daily partitions.
PIPELINE_START_DATE=2026-09-01
# Persistent Dagster instance storage (runs, schedules, asset history).
DAGSTER_HOME=./.dagster_home
